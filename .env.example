# HushDrop Environment Configuration Template
# (No secrets should be committed here)

# Server bind port (default: 8443)
PORT=8443

# Server bind host (0.0.0.0 binds to all local network adapters)
HOST=0.0.0.0

# Portable mode (if true, stores data in ./data alongside the binary)
PORTABLE=true

# Custom data storage path (defaults to ./data when PORTABLE=true)
DATA_DIR=./data

# Maximum upload chunk size in bytes (4MB default)
MAX_CHUNK_SIZE=4194304

# Maximum total file size in bytes (5GB default)
MAX_FILE_SIZE=5368709120

# Rate limit requests per minute per IP
RATE_LIMIT_PER_MINUTE=20

# Pairing PIN TTL in minutes (default: 10)
PIN_TTL_MINUTES=10

# Session inactivity timeout in minutes (default: 10)
SESSION_INACTIVITY_MINUTES=10
