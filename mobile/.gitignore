# Capacitor Mobile Git Ignore Rules

node_modules/
dist/

# Native platform projects generated dynamically via cap sync
android/*
!android/app/
android/app/*
!android/app/build.gradle
!android/app/src/
android/app/src/*
!android/app/src/main/
android/app/src/main/*
!android/app/src/main/AndroidManifest.xml
!android/app/src/main/java/
android/app/src/main/java/*
!android/app/src/main/java/app/
android/app/src/main/java/app/*
!android/app/src/main/java/app/hushdrop/
android/app/src/main/java/app/hushdrop/*
!android/app/src/main/java/app/hushdrop/MainActivity.java
!android/app/src/main/res/
android/app/src/main/res/*
!android/app/src/main/res/xml/
android/app/src/main/res/xml/*
!android/app/src/main/res/xml/network_security_config.xml
ios/

# Curated Android files tracked in git:
# - mobile/android/app/src/main/AndroidManifest.xml
# - mobile/android/app/src/main/java/app/hushdrop/MainActivity.java
# - mobile/android/app/build.gradle
# - mobile/android/app/src/main/res/xml/network_security_config.xml
# (Use 'git add -f' if generic parent ignore rules prevent automatic staging)

# Secrets and certificates
*.key
*.pem
*.crt
*.log
.env
.env.*
!.env.example
