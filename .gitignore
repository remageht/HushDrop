# HushDrop Git Ignore Rules

# Runtime data & secrets (CRITICAL: NEVER COMMIT)
data/
dist/
certs/
*.key
*.pem
.env
*.log

# Build artifacts & binaries
/HushDrop
/HushDrop.exe
*.exe
*.dll
*.so
*.dylib
bin/

# Frontend dependencies & builds
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Mobile Capacitor builds & native projects
mobile/node_modules/
mobile/dist/
mobile/android/
mobile/ios/

# Desktop Tauri builds & targets
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
dist-desktop/

# Embedded web assets (built via npm run build in CI and build scripts)
internal/server/web/*
!internal/server/web/.gitkeep

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# AI agent working files (local only, not for public repo)
.agent/
